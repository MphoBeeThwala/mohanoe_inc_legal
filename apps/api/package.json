{
  "name": "@ahava88/api",
  "version": "0.2.0",
  "private": true,
  "description": "API for the Ahava on 88 white-label legal practice management platform",
  "author": "Ahava on 88 (Pty) Ltd",
  "license": "UNLICENSED",
  "type": "commonjs",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node dist/db/migrate.js",
    "db:studio": "drizzle-kit studio",
    "test:postgres": "vitest run --no-file-parallelism",
    "firm": "node dist/scripts/firm.js"
  },
  "dependencies": {
    "@ahava88/shared": "*",
    "cors": "^2.8.6",
    "dotenv": "^17.4.1",
    "drizzle-orm": "^0.45.4",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.4.0",
    "openid-client": "^6.8.9",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.2",
    "drizzle-kit": "^0.31.11",
    "jose": "^6.2.16",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0"
  },
  "files": [
    "dist",
    "drizzle"
  ]
}
