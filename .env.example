PORT=3001
APP_ORIGIN=http://localhost:3000
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=12h
# Set to true for demo/bootstrap when admin seeding is deferred.
ALLOW_PUBLIC_REGISTRATION=false
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-20250514
INTAKE_ENCRYPTION_KEY=
# PostgreSQL connection string. Leave empty in local development to use an
# embedded Postgres (PGlite) stored in .data/pglite. Required in production.
# e.g. postgres://user:password@host:5432/dbname  (Supabase: use the pooler URI)
DATABASE_URL=
DATABASE_POOL_MAX=10
# Set to false only for a local database without TLS.
DATABASE_SSL=
# Migrations run on start; set to false if you run `npm run db:migrate` separately.
DB_MIGRATE_ON_START=true
# Optional: where local PGlite data lives (default .data/pglite).
PGLITE_DATA_DIR=
VAT_RATE=0.15
CLIENT_DATA_RETENTION_DAYS=3650
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=240
LOG_HTTP=true
AUDIT_CHAIN_SECRET=replace-with-an-audit-chain-secret
# Deferred: set SEED_ADMIN_ON_STARTUP=true to auto-create admin on boot.
SEED_ADMIN_ON_STARTUP=false
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=
DEFAULT_ADMIN_NAME=Practice Admin
JWT_ISSUER=ahava88-legal-pms

# White-label branding (one firm per deployment until multi-tenancy)
FIRM_NAME=
FIRM_SHORT_NAME=
FIRM_LOGO_URL=
FIRM_PRIMARY_COLOR=#1b7a58
FIRM_ACCENT_COLOR=#0f5d43
FIRM_CASE_PREFIX=MAT
PRODUCT_NAME=Legal Practice Workspace
PLATFORM_SUPPORT_EMAIL=
