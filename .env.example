PORT=3001
APP_ORIGIN=http://localhost:3000
# Signs short-lived sign-in challenge and Entra state tokens (sessions themselves are server-side).
JWT_SECRET=replace-with-a-long-random-secret
JWT_ISSUER=ahava88-legal-pms
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-20250514
INTAKE_ENCRYPTION_KEY=
# PostgreSQL connection string. Leave empty in local development to use an
# embedded Postgres (PGlite) stored in .data/pglite. Required in production.
# e.g. postgres://user:password@host:5432/dbname  (Supabase: use the pooler URI)
DATABASE_URL=
DATABASE_POOL_MAX=10
# Set to false only for a local database without TLS.
DATABASE_SSL=
# Migrations run on start; set to false if you run `npm run db:migrate` separately.
DB_MIGRATE_ON_START=true
# Optional: where local PGlite data lives (default .data/pglite).
PGLITE_DATA_DIR=
VAT_RATE=0.15
CLIENT_DATA_RETENTION_DAYS=3650
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=240
LOG_HTTP=true
AUDIT_CHAIN_SECRET=replace-with-an-audit-chain-secret

# ---- Identity. Staff join by invite only; password sign-in always needs an
# authenticator app (TOTP). See README "Staff accounts and sign-in".
# Sessions: httpOnly cookies, Secure + __Host- in production (cannot be turned off there).
SESSION_IDLE_MINUTES=120
SESSION_MAX_HOURS=12
SESSION_COOKIE_SECURE=
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
INVITE_EXPIRY_DAYS=7
PASSWORD_RESET_EXPIRY_MINUTES=60
AUTH_RATE_LIMIT_MAX=20
# Set to false to allow only Entra sign-in.
AUTH_PASSWORD_ENABLED=true
# Entra External ID (OpenID Connect). Issuer looks like
# https://<tenant-id>.ciamlogin.com/<tenant-id>/v2.0. Register
# https://<firm address>/api/auth/oidc/callback as a redirect URI for each firm.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_LABEL=Sign in with Microsoft
# Also require the ID token's amr claim to contain "mfa".
OIDC_REQUIRE_MFA_CLAIM=false
# Outgoing email for invites and resets (Azure Communication Services SMTP works).
# Without it, links are shown to the administrator who creates them.
SMTP_URL=
MAIL_FROM=

# Multi-tenancy: which firm a request belongs to.
# With PLATFORM_BASE_DOMAIN=ahava88.co.za, <slug>.ahava88.co.za resolves to firm <slug>.
# Custom domains are stored on the firm (npm run firm -w apps/api -- create --domain ...).
# DEFAULT_FIRM_SLUG serves hosts that match nothing else (defaults to "default" when no base domain is set).
PLATFORM_BASE_DOMAIN=
DEFAULT_FIRM_SLUG=

# Bootstrap branding: only used to create the first ("default") firm when the firms table is empty.
# After that, branding lives on each firm row.
FIRM_NAME=
FIRM_SHORT_NAME=
FIRM_LOGO_URL=
FIRM_PRIMARY_COLOR=#1b7a58
FIRM_ACCENT_COLOR=#0f5d43
FIRM_CASE_PREFIX=MAT
PRODUCT_NAME=Legal Practice Workspace
PLATFORM_SUPPORT_EMAIL=
