PORT=3001
APP_ORIGIN=http://localhost:3000
# Signs short-lived sign-in challenge and Entra state tokens (sessions themselves are server-side).
JWT_SECRET=replace-with-a-long-random-secret
JWT_ISSUER=ahava88-legal-pms
# AI (roadmap §7). foundry = Claude in Microsoft Foundry (production), anthropic =
# Anthropic API (development), none/empty = no AI (intakes open as "not assessed").
AI_PROVIDER=
# Foundry: https://<resource>.services.ai.azure.com/anthropic (keyless with the
# managed identity when AI_API_KEY is empty).
AI_ENDPOINT=
AI_API_KEY=
# Model (Anthropic) or deployment name (Foundry); research may use a different one.
AI_MODEL=claude-sonnet-5-5
AI_RESEARCH_MODEL=
# Monthly token allowance per firm, and the per-call timeout.
AI_FIRM_MONTHLY_TOKENS=2000000
AI_TIMEOUT_MS=90000
# Legislation feed (Laws.Africa Content API); weekly: npm run ops -w apps/api -- sources sync-laws-africa
LAWS_AFRICA_TOKEN=
# Local key-encryption key (wraps each firm's data keys when KEY_PROVIDER=local)
# and the key of data written before per-firm keys. 64 hex chars or 32-byte base64.
INTAKE_ENCRYPTION_KEY=
# Only while rotating INTAKE_ENCRYPTION_KEY: the old value (then run `ops keys rewrap`).
INTAKE_ENCRYPTION_KEY_PREVIOUS=
# local | azure-keyvault. With Key Vault, AZURE_KEY_VAULT_KEY_ID is an RSA key
# (https://<vault>.vault.azure.net/keys/<name>); access via managed identity.
KEY_PROVIDER=local
AZURE_KEY_VAULT_KEY_ID=
# Where document bodies and audit anchors go: (empty) database | filesystem | azure-blob
OBJECT_STORE=
OBJECT_STORE_DIR=
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONNECTION_STRING=
# Container for audit anchors; give it a time-based immutability (WORM) policy.
AUDIT_ANCHOR_CONTAINER=audit-anchors
# Anchor every firm's audit chain from the API process every N hours (0 = off;
# use a scheduled `npm run ops -w apps/api -- anchor` job instead if you prefer).
AUDIT_ANCHOR_INTERVAL_HOURS=0
# Calendar reminders: run `npm run ops -w apps/api -- reminders` every 15 minutes
# as a scheduled job, or set this to run them inside the API (minutes; 0 = off).
CALENDAR_REMINDER_INTERVAL_MINUTES=0
# Court roll sync: listing pages of published rolls, as a JSON array of
# {"division": "<COURT_DIVISIONS code>", "url": "https://…", "match": "<title filter>"}.
# Empty = no sync (firms can still upload rolls). Run `npm run ops -w apps/api -- court-rolls`
# as a scheduled job (twice a week: cron "0 4 * * 1,4" = Mon and Thu 06:00 SAST).
COURT_ROLL_SOURCES=
# How the sync identifies itself to court websites (include a contact address).
COURT_ROLL_USER_AGENT=
# Or run the sync inside the API every N hours (0 = off; a scheduled job is better).
COURT_ROLL_SYNC_INTERVAL_HOURS=0
# PostgreSQL connection string. Leave empty in local development to use an
# embedded Postgres (PGlite) stored in .data/pglite. Required in production.
# e.g. postgres://user:password@host:5432/dbname  (Supabase: use the pooler URI)
DATABASE_URL=
DATABASE_POOL_MAX=10
# Set to false only for a local database without TLS.
DATABASE_SSL=
# Migrations run on start; set to false if you run `npm run db:migrate` separately.
DB_MIGRATE_ON_START=true
# Optional: where local PGlite data lives (default .data/pglite).
PGLITE_DATA_DIR=
VAT_RATE=0.15
CLIENT_DATA_RETENTION_DAYS=3650
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=240
LOG_HTTP=true
AUDIT_CHAIN_SECRET=replace-with-an-audit-chain-secret

# ---- Identity. Staff join by invite only; password sign-in always needs an
# authenticator app (TOTP). See README "Staff accounts and sign-in".
# Sessions: httpOnly cookies, Secure + __Host- in production (cannot be turned off there).
SESSION_IDLE_MINUTES=120
SESSION_MAX_HOURS=12
SESSION_COOKIE_SECURE=
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
INVITE_EXPIRY_DAYS=7
PASSWORD_RESET_EXPIRY_MINUTES=60
AUTH_RATE_LIMIT_MAX=20
# Set to false to allow only Entra sign-in.
AUTH_PASSWORD_ENABLED=true
# Entra External ID (OpenID Connect). Issuer looks like
# https://<tenant-id>.ciamlogin.com/<tenant-id>/v2.0. Register
# https://<firm address>/api/auth/oidc/callback as a redirect URI for each firm.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_LABEL=Sign in with Microsoft
# Also require the ID token's amr claim to contain "mfa".
OIDC_REQUIRE_MFA_CLAIM=false
# Per-firm Microsoft 365 (Entra ID workforce) sign-in: the platform's
# multi-tenant app registration. Each firm's administrators then set their
# directory (tenant) ID and email domains in the app, and their Microsoft 365
# admin approves the app. Redirect URI per firm: https://<firm address>/api/auth/oidc/callback
ENTRA_WORKFORCE_CLIENT_ID=
ENTRA_WORKFORCE_CLIENT_SECRET=
# Also require amr=mfa in the ID token (normally MFA is enforced with Conditional Access).
ENTRA_WORKFORCE_REQUIRE_MFA_CLAIM=false
# Outgoing email for invites and resets (Azure Communication Services SMTP works).
# Without it, links are shown to the administrator who creates them.
SMTP_URL=
MAIL_FROM=

# Multi-tenancy: which firm a request belongs to.
# With PLATFORM_BASE_DOMAIN=ahava88.co.za, <slug>.ahava88.co.za resolves to firm <slug>.
# Custom domains are stored on the firm (npm run firm -w apps/api -- create --domain ...).
# DEFAULT_FIRM_SLUG serves hosts that match nothing else (defaults to "default" when no base domain is set).
PLATFORM_BASE_DOMAIN=
DEFAULT_FIRM_SLUG=

# Bootstrap branding: only used to create the first ("default") firm when the firms table is empty.
# After that, branding lives on each firm row.
FIRM_NAME=
FIRM_SHORT_NAME=
FIRM_LOGO_URL=
FIRM_PRIMARY_COLOR=#1b7a58
FIRM_ACCENT_COLOR=#0f5d43
FIRM_CASE_PREFIX=MAT
PRODUCT_NAME=Legal Practice Workspace
PLATFORM_SUPPORT_EMAIL=

# Custom domains: the host firms point their CNAME at (the Front Door endpoint,
# e.g. firms-xxxx.z01.azurefd.net). Shown to firms when they add a domain.
# Recheck pending domains with `npm run ops -w apps/api -- domains` (hourly job).
CUSTOM_DOMAIN_CNAME_TARGET=

# Monitoring (optional): 5xx errors go to Sentry with personal information removed
SENTRY_DSN=
DEPLOY_ENVIRONMENT=development
APP_RELEASE=
# Behind Azure Front Door: its profile ID (X-Azure-FDID) and the number of proxies in front of the API
FRONT_DOOR_ID=
TRUST_PROXY_HOPS=1

# Firm subscriptions (PayFast, the platform's merchant account). Without these,
# firms see that online payment isn't available yet. Daily: `npm run ops -w apps/api -- subscriptions`.
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true
SUBSCRIPTION_TRIAL_DAYS=30
SUBSCRIPTION_TRIAL_SEATS=10
SUBSCRIPTION_GRACE_DAYS=7
# VAT the platform charges firms (0 if Ahava on 88 is not VAT-registered)
PLATFORM_VAT_RATE=0.15
